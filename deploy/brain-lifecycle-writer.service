[Unit]
# The only component holding a credential that can change a lifecycle status
# in FamaChat. It runs beside Brain rather than inside it so that credential
# never sits in the process that also serves model-visible tools (spec 13).
Description=Brain lifecycle writer (FamaChat status effects)
After=network-online.target brain.service
Wants=network-online.target
PartOf=brain.service

[Service]
Type=simple
WorkingDirectory=/root/brain
# The FamaChat write credential lives here and nowhere else: not in a Hermes
# Profile, not in a model-visible MCP config, not in the observer, not in
# brain.service. This file must be 0600.
EnvironmentFile=/etc/brain/writer.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/brain/.venv/bin/brain-lifecycle-writer

Restart=on-failure
RestartSec=5

# Every write is protected by a lease and a server-side predicate, so a restart
# is safe: the next run re-reads before deciding anything.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Brain's runtime database is the only writable path. Notably absent: the
# Hermes installation, the Hermes WhatsApp session, and the observer session.
ReadWritePaths=/var/lib/brain/runtime
ReadOnlyPaths=/root/brain

[Install]
WantedBy=multi-user.target
