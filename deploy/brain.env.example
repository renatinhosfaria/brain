# Copy to /etc/brain/brain.env with mode 0600.
BRAIN_CONFIG=/etc/brain/brain.toml
# Required stable secrets. Replace every placeholder in the installed 0600 file.
# One stable transport HMAC key of at least 32 random bytes. Amendment 2
# removed the separate runtime domain along with the identifiers that used it;
# BRAIN_RUNTIME_HMAC_SECRET is now ignored and may be deleted from an existing
# installed file. Every derived identifier lives in this one domain.
BRAIN_TRANSPORT_HMAC_SECRET=replace-with-transport-secret

# Install these only with scripts/install_meta_ads_credential.py. They are
# synthetic placeholders, never command-line arguments or repository secrets.
BRAIN_META_ADS_MCP_ACCESS_TOKEN=replace-with-meta-ads-mcp-access-token
BRAIN_META_ADS_MCP_TOKEN_EXPIRES_AT=2099-01-01T00:00:00Z

# Explicitly select token (legacy rollback) or oauth. OAuth secrets are kept
# only in the encrypted store, never in this environment file.
BRAIN_META_ADS_MCP_AUTH_MODE=token
BRAIN_META_ADS_OAUTH_STORE=/var/lib/brain/credentials/meta-ads-oauth.json.enc
BRAIN_META_ADS_OAUTH_KEY=/etc/brain/meta-ads-oauth.key
BRAIN_META_ADS_OAUTH_REDIRECT_URI=http://127.0.0.1:8766/oauth/callback

# Raw principal credentials live only in the corresponding caller secret
# scopes. These commented placeholders document required provisioning inputs;
# do not uncomment them in the Brain service environment.
# BRAIN_GATEWAY_TOKEN=replace-with-gateway-token
# BRAIN_OBSERVER_TOKEN=replace-with-observer-token

# The TOML stores only distinct principal digests. Raw worker tokens
# remain in each Hermes Profile secret scope; BRAIN_GATEWAY_TOKEN remains in the
# CEO Hermes secret scope. Never put raw tokens in Git or in this file.
