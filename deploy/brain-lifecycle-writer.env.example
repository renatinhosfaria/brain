# Copy to /etc/brain/writer.env, mode 0600, owned by root.
#
# This file holds the only credential in the deployment that can change a
# lifecycle status in FamaChat. It must never be copied into a Hermes Profile,
# a model-visible MCP configuration, the observer, or brain.service.

# Brain principal for the writer. Distinct from the CEO, the workers and the
# observer, with only lifecycle_claim and lifecycle_result.
BRAIN_WRITER_TOKEN=replace-with-writer-token
BRAIN_URL=http://127.0.0.1:8765

# FamaChat MCP endpoint and the writer's own credential. Separate from the one
# the Reno Profile uses: a leaked Profile key must not be able to change status.
FAMACHAT_MCP_URL=https://mcp.famachat.com.br/mcp
FAMACHAT_WRITER_KEY=replace-with-writer-famachat-key

# Artefacts the write gate checks before allowing any mutation. Both are
# produced on this machine and are not committed.
BRAIN_CONDITIONAL_WRITE_PROOF=/var/lib/brain/runtime/famachat-conditional-write-proof.json
BRAIN_WRITER_SCHEMA=/root/brain/tests/fixtures/famachat-writer-tools.json

# The local half of the write switch. Writing also requires Brain's claim to
# say write and the recorded proof to match the live schema fingerprint;
# setting this alone changes nothing.
BRAIN_LIFECYCLE_WRITE_ENABLED=false

# Local health only, never exposed off-host.
BRAIN_WRITER_HEALTH_HOST=127.0.0.1
BRAIN_WRITER_HEALTH_PORT=8776
