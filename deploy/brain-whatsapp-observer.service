[Unit]
Description=Brain receive-only WhatsApp observer
After=network-online.target brain.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/brain/observers/whatsapp
EnvironmentFile=/etc/brain/whatsapp-observer.env
ExecStart=/opt/brain/node/bin/node /root/brain/observers/whatsapp/src/main.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/brain/whatsapp-observer

[Install]
WantedBy=multi-user.target
