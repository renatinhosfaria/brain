[server]
state_db = "/root/.hermes/state.db"
kanban_db = "/root/.hermes/kanban.db"
whatsapp_session_dir = "/root/.hermes/platforms/whatsapp/session"
runtime_db = "/var/lib/brain/runtime/brain-runtime.db"
observer_session_dir = "/var/lib/brain/whatsapp-observer/session"
# Expected observer identities. Transport ingestion derives event IDs
# from these, so a fresh deployment resolves its first message before any
# transport event exists to discover the device from. Must match the
# observer's BRAIN_OBSERVER_DEVICE_ID.
observer_device_ids = ["fama-whatsapp-observer-1"]
transport_retention_days = 90
display_name_ttl_hours = 24
board = "default"
host = "127.0.0.1"
port = 8765
history_budget_chars = 12000
message_max_chars = 2000
ctwa_raw_max_bytes = 4194304
ctwa_raw_max_depth = 32
ctwa_raw_max_nodes = 10000
context_response_max_bytes = 33554432
busy_retries = 2
busy_timeout_seconds = 1.0
# Keep this stable across restarts so issued pagination cursors remain valid.
# Generate with: openssl rand -hex 32
# cursor_secret = "replace-with-64-hex-characters"
# Required production secrets are supplied only through these environment vars:
# BRAIN_TRANSPORT_HMAC_SECRET (Brain/observer transport domain, 32+ bytes)

# Store only distinct digests in this file. Generate a digest with:
#   /root/brain/scripts/brain-token-hash
[principals.default]
mode = "gateway"
token_sha256 = "replace-with-gateway-64-hex-digest"
tools = ["conversation_context"]

[principals.observer]
mode = "service"
token_sha256 = "replace-with-observer-64-hex-digest"
tools = ["transport_ingest"]

[principals.porteiro]
mode = "worker"
token_sha256 = "replace-with-porteiro-64-hex-digest"
tools = ["conversation_phone"]

[principals.cadastro]
mode = "worker"
token_sha256 = "replace-with-cadastro-64-hex-digest"
tools = ["conversation_phone"]

[principals.reno]
mode = "worker"
token_sha256 = "replace-with-reno-64-hex-digest"
tools = ["conversation_recent", "conversation_search"]

[principals.famaagent]
mode = "worker"
token_sha256 = "replace-with-famaagent-64-hex-digest"
tools = ["conversation_recent", "conversation_search"]
