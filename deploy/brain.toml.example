[server]
state_db = "/root/.hermes/state.db"
kanban_db = "/root/.hermes/kanban.db"
whatsapp_session_dir = "/root/.hermes/platforms/whatsapp/session"
board = "default"
host = "127.0.0.1"
port = 8765
history_budget_chars = 12000
message_max_chars = 2000
busy_retries = 2
busy_timeout_seconds = 1.0
# Keep this stable across restarts so issued pagination cursors remain valid.
# Generate with: openssl rand -hex 32
# cursor_secret = "replace-with-64-hex-characters"

# Store only distinct digests in this file. Generate a digest with:
#   /root/brain/scripts/brain-token-hash
[principals.default]
mode = "gateway"
token_sha256 = "replace-with-gateway-64-hex-digest"
tools = ["conversation_phone"]

[principals.porteiro]
mode = "worker"
token_sha256 = "replace-with-porteiro-64-hex-digest"
tools = ["conversation_phone"]

[principals.cadastro]
mode = "worker"
token_sha256 = "replace-with-cadastro-64-hex-digest"
tools = ["conversation_phone"]

[principals.reno]
mode = "worker"
token_sha256 = "replace-with-reno-64-hex-digest"
tools = ["conversation_recent", "conversation_search"]

[principals.famaagent]
mode = "worker"
token_sha256 = "replace-with-famaagent-64-hex-digest"
tools = ["conversation_recent", "conversation_search"]
