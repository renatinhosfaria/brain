[Unit]
Description=Brain V2 conversation identity and longitudinal memory service
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/brain
EnvironmentFile=/etc/brain/brain.env
Environment=PYTHONUNBUFFERED=1
# `/etc/brain/brain.toml` binds 127.0.0.1 and sets the Brain-owned runtime DB to
# /var/lib/brain/runtime/brain-runtime.db. Create the directory as mode 0700;
# Brain creates/maintains the database as mode 0600 under UMask=0077.
Environment=BRAIN_CONFIG=/etc/brain/brain.toml
ExecStart=/root/brain/.venv/bin/brain
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/brain/runtime /var/lib/brain/credentials
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Ads MCP requires outbound HTTPS; root-only Brain keeps network capability.
# The runtime DB and encrypted OAuth credential directories are the sole
# writable application paths.
# The future whatsapp-observer service is not installed or enabled by this unit.
# ProtectHome is read-only, not hidden: Brain must read /root/.hermes. Never
# modify /usr/local/lib/hermes-agent; Brain reads the installed Hermes runtime.

[Install]
WantedBy=multi-user.target
