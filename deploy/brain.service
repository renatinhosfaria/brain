[Unit]
Description=Brain V2 conversation identity and longitudinal memory service
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/brain
# The only EnvironmentFile is the root-owned Brain secret file (mode 0600).
EnvironmentFile=/etc/brain/brain.env
Environment=PYTHONUNBUFFERED=1
# `/etc/brain/brain.toml` binds 127.0.0.1 and sets the Brain-owned runtime DB to
# /var/lib/brain/runtime/brain-runtime.db. Create the directory as mode 0700;
# Brain creates/maintains the database as mode 0600 under UMask=0077.
Environment=BRAIN_CONFIG=/etc/brain/brain.toml
ExecStart=/root/brain/.venv/bin/brain
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# The future whatsapp-observer service is not installed or enabled by this unit.
# The optional remote Meta MCP remains disabled until the local probe reports
# the exact account. Run it manually; this unit grants no extra paths or
# network families beyond the Brain service boundary.
# ProtectHome=true is intentionally absent: V2 must read /root/.hermes.
# ProtectSystem=strict is intentionally left for the live WAL/SHM hardening
# validation described in the PRD; do not enable it without that test. Never
# modify /usr/local/lib/hermes-agent; Brain reads the installed Hermes runtime.

[Install]
WantedBy=multi-user.target
